        <defName>BEWH_ImperiumOfficerPawn</defName>
        <label>Imperial officer</label>
        <combatPower>60</combatPower>
        <isFighter>true</isFighter>
        <itemQuality>Good</itemQuality>
        <minGenerationAge>28</minGenerationAge>
