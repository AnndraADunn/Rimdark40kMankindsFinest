        <requiredWorkTags>
            <li>Social</li>
        </requiredWorkTags>
        <weaponTags>
            <li>IndustrialGunAdvanced</li>
        </weaponTags>
        <weaponMoney>800~1600</weaponMoney>
        <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
