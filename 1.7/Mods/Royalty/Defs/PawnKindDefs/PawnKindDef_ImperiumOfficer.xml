        <skills>
            <li>
                <skill>Social</skill>
                <range>8~14</range>
            </li>
            <li>
                <skill>Shooting</skill>
                <range>5~10</range>
            </li>
        </skills>
        <royalTitleChance>1</royalTitleChance>
        <titleSelectOne>
            <li>BEWH_NPCTitleCommissar</li>
            <li>BEWH_NPCTitleCastellan</li>
            <li>BEWH_NPCTitleRogueTrader</li>
            <li>BEWH_NPCTitleGovernor</li>
        </titleSelectOne>
    </PawnKindDef>

</Defs>
