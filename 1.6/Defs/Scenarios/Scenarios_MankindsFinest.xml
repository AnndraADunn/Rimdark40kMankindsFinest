<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ScenarioDef ParentName="ScenarioBase">
        <defName>BEWH_LostStrikeForce</defName>
        <label>Lost Strike Force</label>
        <description>Your Thunderhawk was torn apart in the upper atmosphere. Five battle-brothers walked out of the wreckage. Two did not, and their gene-seed now rests in the Apothecary's care. There is no fleet coming. If the Chapter is to endure on this world, you will have to rebuild it yourselves.\n\nNote: You start with five wounded Space Marines in damaged armour and very little else. Gene-seed vials spoil within a day when set down outside vial storage, so let the Apothecary keep them.</description>
        <scenario>
            <summary>Five Space Marines survive a crash, carrying the gene-seed of the fallen.</summary>
            <parts>

                <!-- Config pages -->
                <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs">
                    <def>ConfigurePawnsKindDefs</def>
                    <pawnChoiceCount>8</pawnChoiceCount>
                    <leftBehindPawnKind>BEWH_StrikeForceBattleBrother</leftBehindPawnKind>
                    <kindCounts>
                        <li>
                            <kindDef>BEWH_StrikeForceSergeant</kindDef>
                            <count>1</count>
                            <requiredAtStart>true</requiredAtStart>
                        </li>
                        <li>
                            <kindDef>BEWH_StrikeForceApothecary</kindDef>
                            <count>1</count>
                            <requiredAtStart>true</requiredAtStart>
                        </li>
                        <li>
                            <kindDef>BEWH_StrikeForceTechmarine</kindDef>
                            <count>1</count>
                            <requiredAtStart>true</requiredAtStart>
                        </li>
                        <li>
                            <kindDef>BEWH_StrikeForceBattleBrother</kindDef>
                            <count>2</count>
                            <requiredAtStart>true</requiredAtStart>
                        </li>
                    </kindCounts>
                </li>

                <!-- Player starting stuff spawn method -->
                <li Class="ScenPart_PlayerPawnsArriveMethod">
                    <def>PlayerPawnsArriveMethod</def>
                    <method>DropPods</method>
                    <visible>false</visible>
                </li>

                <!-- Player pawns modifiers -->
                <li Class="Genes40k.ScenPart_CrashInjuries">
                    <def>BEWH_CrashInjuries</def>
                    <context>PlayerStarter</context>
                    <chance>1</chance>
                    <injuryCount>1~3</injuryCount>
                    <injurySeverity>3~9</injurySeverity>
                    <injuries>
                        <li>Cut</li>
                        <li>Bruise</li>
                        <li>Burn</li>
                        <li>Crush</li>
                    </injuries>
                </li>

                <!-- Chapter -->
                <li Class="Genes40k.ScenPart_StartingChapter">
                    <def>BEWH_StartingChapter</def>
                </li>

                <!-- Player starting things -->
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Silver</thingDef>
                    <count>300</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MealSurvivalPack</thingDef>
                    <count>30</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MedicineIndustrial</thingDef>
                    <count>15</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>ComponentIndustrial</thingDef>
                    <count>15</count>
                </li>

                <!-- Scatter some things near player start -->
                <li Class="ScenPart_ScatterThingsNearPlayerStart">
                    <def>ScatterThingsNearPlayerStart</def>
                    <thingDef>ShipChunk</thingDef>
                    <allowRoofed>false</allowRoofed>
                    <count>3</count>
                </li>
                <li Class="ScenPart_ScatterThingsNearPlayerStart">
                    <def>ScatterThingsNearPlayerStart</def>
                    <thingDef>Steel</thingDef>
                    <count>300</count>
                </li>
                <li Class="ScenPart_ScatterThingsNearPlayerStart">
                    <def>ScatterThingsNearPlayerStart</def>
                    <thingDef>Plasteel</thingDef>
                    <count>40</count>
                </li>

                <!-- Scatter some things anywhere -->
                <li Class="ScenPart_ScatterThingsAnywhere">
                    <def>ScatterThingsAnywhere</def>
                    <thingDef>ShipChunk</thingDef>
                    <allowRoofed>false</allowRoofed>
                    <count>2</count>
                </li>

                <!-- Game start dialog -->
                <li Class="ScenPart_GameStartDialog">
                    <def>GameStartDialog</def>
                    <text>The Thunderhawk came apart above the clouds. Five of you walked out of the burning wreck. Two brothers did not, and the Apothecary carries what remains of them.\n\nNo fleet is coming. Salvage what you can, tend to your wounds and keep the gene-seed safe. Through it, the Chapter will live on.</text>
                    <closeSound>GameStartSting</closeSound>
                </li>

            </parts>
        </scenario>
    </ScenarioDef>

</Defs>
